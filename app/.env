# Public settings for the live app. Nothing here is secret: all of it ends up in
# the page's code anyway. Committed so the hosted build (Netlify) uses them.
# For local testing on a practice chain, override them in .env.local (not committed).

# The Ajo contract on Robinhood Chain (vouching version, deployed 2026-11-09).
VITE_AJO_ADDRESS=0xDf3f3743768c2609F3b33d9dEad43E95DC016588
VITE_AJO_DEPLOY_BLOCK=110190974

# WalletConnect / Reown project, so phone wallets can connect by QR code.
VITE_WALLETCONNECT_PROJECT_ID=aeeb25291938514da03bf433a56cad88
